{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tasks",
    "action",
    "origin",
    "destination",
    "origin_choice",
    "destination_choice",
    "conditions",
    "rag_query",
    "clarification"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "enum": [
          "rules",
          "journey",
          "live_queue",
          "out_of_scope",
          "general",
          "facilities"
        ]
      }
    },
    "action": {
      "enum": [
        "keep",
        "update",
        "new",
        "reverse",
        "clarify"
      ]
    },
    "origin": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query",
            "kind"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "auto",
                "place",
                "area"
              ]
            }
          }
        }
      ]
    },
    "destination": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query",
            "kind"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "auto",
                "place",
                "area"
              ]
            }
          }
        }
      ]
    },
    "origin_choice": {
      "type": [
        "string",
        "null"
      ]
    },
    "destination_choice": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "luggage",
        "taxi_type"
      ],
      "properties": {
        "luggage": {
          "type": [
            "string",
            "null"
          ]
        },
        "taxi_type": {
          "enum": [
            null,
            "urban",
            "nt",
            "lantau"
          ]
        },
        "boarding_type": {
          "enum": [
            null,
            "ordinary",
            "cross_harbour_stand"
          ]
        },
        "service_mode": {
          "enum": [
            null,
            "street_or_stand",
            "ordinary_phone_booking",
            "fleet_prebooked",
            "unknown"
          ]
        },
        "animal_role": {
          "enum": [
            null,
            "guide_dog",
            "ordinary_pet",
            "unknown"
          ]
        },
        "pickup_facility_kind": {
          "enum": [
            null,
            "ordinary_stand",
            "cross_harbour_stand",
            "fleet_prebooked_pickup",
            "prebooked_pickup",
            "unknown"
          ]
        },
        "fleet_price_mode": {
          "enum": [
            null,
            "meter_plus_booking",
            "agreed_total",
            "unknown"
          ]
        },
        "fleet_booking_cent": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "platform_agreed_total_cent": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "pet_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "bags": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count",
                  "location",
                  "total_cm",
                  "item_type",
                  "mobility_use",
                  "light_status"
                ],
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "location": {
                    "enum": [
                      null,
                      "trunk",
                      "passenger_compartment"
                    ]
                  },
                  "total_cm": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "item_type": {
                    "enum": [
                      null,
                      "bag",
                      "stroller",
                      "wheelchair",
                      "crutch"
                    ]
                  },
                  "mobility_use": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "light_status": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "rag_query": {
      "type": "string"
    },
    "clarification": {
      "type": "string"
    },
    "via": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "query",
              "kind"
            ],
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "auto",
                  "place",
                  "area"
                ]
              }
            }
          }
        }
      ]
    },
    "access_update": {
      "enum": [
        null,
        "origin",
        "destination"
      ]
    },
    "facility_request": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query",
            "kind"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                null,
                "ordinary_stand",
                "cross_harbour_stand",
                "fleet_prebooked_pickup",
                "prebooked_pickup"
              ]
            }
          }
        }
      ]
    },
    "facility_choice": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
